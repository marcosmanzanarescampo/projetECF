// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//  ************************ M O D E L S ****************************************

// Enumérations
enum EventTypePlace {
  limit
  no_limit
}

enum UserTypeBadge {
  basic
  advanced
}

enum LikeType {
  heart
  top
}

// Modèle `User`
model User {
  user_id         Int            @id @default(autoincrement())
  user_first_name String         @db.VarChar(50)
  user_name       String         @db.VarChar(50)
  user_email      String         @unique @db.VarChar(50)
  user_password   String         
  user_badge      UserTypeBadge  @default(basic)
  user_created_at DateTime       @default(now())
  
  eventsCreated   Event[]        @relation("EventCreatedBy")
  likes           Like[]         @relation("LikeUser")
  registrations   Registration[] @relation("RegistrationUser")
}

// Modèle `Event`
model Event {
  event_id           Int            @id @default(autoincrement())
  event_titre        String
  event_description  String
  event_city         String
  event_places       EventTypePlace
  event_places_number Int
  event_date_hour    DateTime
  event_created_at   DateTime       @default(now())  
  event_createdBy    Int            // Clé étrangère vers `User`

  createdByUser      User           @relation("EventCreatedBy", fields: [event_createdBy], references: [user_id]) // Relation vers `User`

  likes              Like[]         @relation("LikeEvent")
  registrations      Registration[] @relation("RegistrationEvent")
}

// Modèle `Like`
model Like {
  user            Int
  event           Int
  like_created_at DateTime @default(now())
  type            LikeType

  userUser        User    @relation("LikeUser", fields: [user], references: [user_id])
  eventEvent      Event   @relation("LikeEvent", fields: [event], references: [event_id])

  @@id([user, event])
}

// Modèle `Registration`
model Registration {
  register_user   Int
  register_event  Int
  register_created_at DateTime @default(now())

  user            User    @relation("RegistrationUser", fields: [register_user], references: [user_id])
  event           Event   @relation("RegistrationEvent", fields: [register_event], references: [event_id])

  @@id([register_user, register_event])
}

